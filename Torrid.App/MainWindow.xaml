<Window x:Class="Torrid.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Torrid.App.ViewModels"
        xmlns:views="clr-namespace:Torrid.App.Views"
        Title="Torrid" Width="1000" Height="680" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SensorsViewModel}">
            <views:SensorsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThresholdsViewModel}">
            <views:ThresholdsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,24">
                    <!-- Logo: a small thermometer on an accent tile -->
                    <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8E9CFF" Offset="0"/>
                                <GradientStop Color="#5E6FF0" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Canvas Width="12" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Canvas.Left="3" Canvas.Top="0" Width="6" Height="14" RadiusX="3" RadiusY="3"
                                       Stroke="White" StrokeThickness="1.6"/>
                            <Ellipse Canvas.Left="1" Canvas.Top="10" Width="10" Height="10" Fill="White"/>
                            <Rectangle Canvas.Left="5.2" Canvas.Top="5" Width="1.6" Height="7" Fill="White"/>
                        </Canvas>
                    </Border>
                    <TextBlock Text="Torrid" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,1"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Items}" Focusable="False" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Navigation"
                                         Content="{Binding Title}" Tag="{Binding Glyph}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="{Binding Title}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Current page -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"/>
    </Grid>
</Window>
