<Window x:Class="Torrid.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Torrid.App.ViewModels"
        xmlns:views="clr-namespace:Torrid.App.Views"
        Title="Torrid" Width="1000" Height="680" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SensorsViewModel}">
            <views:SensorsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThresholdsViewModel}">
            <views:ThresholdsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverlaySettingsViewModel}">
            <views:OverlayView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,24">
                    <!-- Logo: the Torrid sculpture (Assets/torrid-logo.png) -->
                    <Image Source="pack://application:,,,/Assets/torrid-logo.png" Width="34" Height="34"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Torrid" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,1"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Items}" Focusable="False" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Navigation"
                                         Content="{Binding Title}" Tag="{Binding Glyph}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="{Binding Title}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Current page -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"/>
    </Grid>
</Window>
