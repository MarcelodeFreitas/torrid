<Window x:Class="Torrid.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" Title="Torrid overlay">
    <Border Background="#99000000" CornerRadius="6" Padding="10,6">
        <TextBlock x:Name="LinesText" FontFamily="Segoe UI" FontWeight="SemiBold" TextWrapping="NoWrap"/>
    </Border>
</Window>
