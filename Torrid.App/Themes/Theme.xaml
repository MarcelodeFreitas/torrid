<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Torrid.App.Converters">

    <!-- Note: WPF hex colours are #AARRGGBB (alpha first). -->

    <!-- ===== Colours ===== -->
    <Color x:Key="WindowBackgroundColor">#20232A</Color>
    <Color x:Key="SidebarBackgroundColor">#181B20</Color>
    <Color x:Key="CardBackgroundColor">#14306B</Color>
    <Color x:Key="CardBorderColor">#2B4A8F</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#A8B6D4</Color>
    <Color x:Key="TextMutedColor">#8592B0</Color>
    <Color x:Key="AccentColor">#7C8CFF</Color>
    <Color x:Key="ZoneBlueColor">#5AA9FF</Color>
    <Color x:Key="ZoneGreenColor">#4ED36B</Color>
    <Color x:Key="ZoneYellowColor">#FFC93C</Color>
    <Color x:Key="ZoneRedColor">#FF5C4D</Color>
    <Color x:Key="ZoneUnknownColor">#8A94A6</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ZoneBlueBrush" Color="{StaticResource ZoneBlueColor}"/>
    <SolidColorBrush x:Key="ZoneGreenBrush" Color="{StaticResource ZoneGreenColor}"/>
    <SolidColorBrush x:Key="ZoneYellowBrush" Color="{StaticResource ZoneYellowColor}"/>
    <SolidColorBrush x:Key="ZoneRedBrush" Color="{StaticResource ZoneRedColor}"/>
    <SolidColorBrush x:Key="ZoneUnknownBrush" Color="{StaticResource ZoneUnknownColor}"/>
    <SolidColorBrush x:Key="ZoneUnknownDimBrush" Color="{StaticResource ZoneUnknownColor}" Opacity="0.7"/>

    <SolidColorBrush x:Key="NavHoverBrush" Color="#0CFFFFFF"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#3A2F12"/>
    <SolidColorBrush x:Key="BannerBorderBrush" Color="#7A5F1C"/>
    <SolidColorBrush x:Key="BannerTextBrush" Color="#FFD98A"/>

    <!-- ===== Fonts ===== -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== Converters ===== -->
    <conv:ColorZoneToBrushConverter x:Key="ZoneToBrush"/>
    <conv:SpacedCapsConverter x:Key="SpacedCaps"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- ===== Text ===== -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="IconTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- ===== Cards ===== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Width" Value="220"/>
        <Setter Property="Height" Value="150"/>
        <Setter Property="Margin" Value="0,0,14,14"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Thin rounded meter: PART_Indicator width = Value x track width (ProgressBar does the maths). -->
    <Style x:Key="ZoneBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource TrackBrush}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Navigation ===== -->
    <Style x:Key="NavFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="6,2" RadiusX="6" RadiusY="6" Stroke="{StaticResource AccentBrush}"
                               StrokeThickness="1.5" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar row: Content = title, Tag = Segoe Fluent Icons glyph. -->
    <Style x:Key="NavButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NavFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Highlight" Background="Transparent"/>
                        <Border x:Name="Indicator" Width="3" Margin="0,10" CornerRadius="0,2,2,0"
                                HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"
                                Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="20,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph" Style="{StaticResource IconTextStyle}"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="18" Width="18"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock x:Name="Title" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="14" Margin="14,0,0,0"
                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Highlight" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Highlight" Property="Background" Value="{StaticResource NavSelectedBrush}"/>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter TargetName="Title" Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scroll bars (thin, dark) ===== -->
    <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" CornerRadius="3" Background="{StaticResource ScrollThumbBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="4,2">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
