<UserControl x:Class="Torrid.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Torrid.App.ViewModels">
    <UserControl.Resources>
        <!-- Big number: zone colour, or slate grey when the sensor has no reading. -->
        <Style x:Key="ValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{Binding Zone, Converter={StaticResource ZoneToBrush}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource ZoneUnknownBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- "°C" suffix: same colour at 70 %; dropped entirely when there is no reading. -->
        <Style x:Key="UnitRunStyle" TargetType="Run">
            <Setter Property="Text" Value="°C"/>
            <Setter Property="Foreground" Value="{Binding Zone, Converter={StaticResource ZoneToBrush}, ConverterParameter=0.7}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="Text" Value=""/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="SensorCardTemplate" DataType="{x:Type vm:SensorCardViewModel}">
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Label}" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Text="{Binding Caption}" FontSize="11" Margin="0,1,0,0"
                               Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Row="2" Style="{StaticResource ValueTextStyle}" VerticalAlignment="Center"
                               LineStackingStrategy="BlockLineHeight" LineHeight="62">
                        <Run Text="{Binding ValueText, Mode=OneWay}" FontSize="56" FontWeight="SemiBold"/><Run
                             Style="{StaticResource UnitRunStyle}" FontSize="20" FontWeight="Normal"/>
                    </TextBlock>

                    <ProgressBar Grid.Row="3" Style="{StaticResource ZoneBarStyle}" Value="{Binding Fill, Mode=OneWay}"
                                 Foreground="{Binding Zone, Converter={StaticResource ZoneToBrush}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DeviceGroupTemplate" DataType="{x:Type vm:DeviceGroupViewModel}">
            <StackPanel Margin="0,0,12,10">
                <TextBlock Margin="2,0,0,12">
                    <Run Text="{Binding Title, Mode=OneWay, Converter={StaticResource SpacedCaps}}" FontSize="13"
                         FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/><Run
                         Text="   "/><Run Text="{Binding Subtitle, Mode=OneWay}" FontSize="12"
                         Foreground="{StaticResource TextMutedBrush}"/>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource SensorCardTemplate}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Right margin is small because cards/groups carry their own right spacing; header and banner add it back. -->
    <Grid Margin="32,28,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,24,0">
            <TextBlock Text="Home" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Live temperatures — choose what shows up on the Sensors page."/>
        </StackPanel>

        <!-- Anti-cheat banner -->
        <Border Grid.Row="1" Margin="0,20,24,0" Padding="14,11" CornerRadius="8" BorderThickness="1"
                Background="{StaticResource BannerBackgroundBrush}" BorderBrush="{StaticResource BannerBorderBrush}"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconTextStyle}" Text="&#xE946;" FontSize="16"
                           Foreground="{StaticResource BannerTextBrush}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource BannerTextBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Device groups -->
        <ScrollViewer Grid.Row="2" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <!-- Groups flow side by side while they fit, so a few single-card devices share one row. -->
            <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource DeviceGroupTemplate}"
                          Focusable="False" Margin="0,0,0,14">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,0,24,60" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE9CA;" FontSize="40"
                       Foreground="{StaticResource TextMutedBrush}" Opacity="0.6" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding EmptyMessage}" FontSize="14" Margin="0,14,0,0" MaxWidth="420"
                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
