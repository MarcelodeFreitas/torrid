<UserControl x:Class="Torrid.App.Views.ThresholdsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Torrid.App.ViewModels"
             xmlns:conv="clr-namespace:Torrid.App.Converters"
             Background="Transparent" Focusable="True" IsTabStop="False" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool"/>

        <!-- List columns: the header and every row use these, so the boxes line up. A row sits 22 DIPs in from the edge
             (section frame 1 + inset 8 + row border 1 + padding 12), so the header is inset the same. Both live in the list's
             scrolled content, which already excludes the scroll bar. -->
        <GridLength x:Key="ListValueWidth">62</GridLength>
        <GridLength x:Key="ListLimitWidth">76</GridLength>
        <GridLength x:Key="ListStatusWidth">70</GridLength>
        <GridLength x:Key="ListResetWidth">32</GridLength>

        <!-- Tick label centred on a segment boundary (it sits at the right edge of its column). -->
        <Style x:Key="TickStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Margin" Value="0,0,-20,0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <!-- With a bad ordering the boundaries collapse onto each other; hide them (keeping the height) until fixed. -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ThresholdFieldLabel">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Ellipse Width="8" Height="8" Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                         VerticalAlignment="Center" Margin="0,1,6,0"/>
                <TextBlock Text="{Binding}" Style="{StaticResource FieldLabelStyle}"/>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Shared by the cards and the list ===== -->

        <!-- Live value in the zone colour; dimmed when there is no reading. -->
        <Style x:Key="SensorValueStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding Zone, Converter={StaticResource ZoneToBrush}}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasValue}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource ZoneUnknownBrush}"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Default / Custom badge: Custom is an accent pill, Default a quiet outline. -->
        <Style x:Key="BadgeBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource SecondaryButtonBorderBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Background" Value="{StaticResource SelectedCardBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Limit boxes in the dense list: a little shorter than the card boxes. -->
        <Style x:Key="ListLimitBoxStyle" TargetType="TextBox" BasedOn="{StaticResource NumberBoxStyle}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ListHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <!-- Shown by view mode: the cards and the list are two scroll areas, one of which is shown at a time. -->
        <Style x:Key="CardsOnlyStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsListView}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListOnlyStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsListView}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Cards / List segmented toggle. -->
        <Style x:Key="SegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="14,0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedCardBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section header: a full-width bar with a chevron; the body only shows while expanded. -->
        <Style x:Key="SectionToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent" Padding="16,12" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Chevron" Text="&#xE76C;" Style="{StaticResource IconTextStyle}" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="10" SnapsToDevicePixels="True">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top" Style="{StaticResource SectionToggleStyle}"
                                              Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Content="{TemplateBinding Content}"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Defaults section: collapsed at first, with the same outline as the device sections. -->
        <Style x:Key="DefaultsSectionStyle" TargetType="Expander" BasedOn="{StaticResource SectionExpanderStyle}">
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>

        <DataTemplate x:Key="SectionTitleTemplate">
            <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DataTemplate>

        <!-- ===== Cards view: one card per sensor ===== -->
        <DataTemplate x:Key="SensorCardTemplate" DataType="{x:Type vm:SensorThresholdViewModel}">
            <Border Style="{StaticResource PanelCardStyle}" Width="300" Margin="0,0,14,14" Padding="16,14,16,12" VerticalAlignment="Top"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitleStyle}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Label}"/>
                            <TextBlock Text="{Binding Caption}" Style="{StaticResource CaptionTextStyle}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Caption}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource InputBackgroundBrush}" CornerRadius="10" Padding="10,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ValueText}" Style="{StaticResource SensorValueStyle}"/>
                        </Border>
                    </Grid>

                    <!-- The three limits (°C): the same boxes and labels as the defaults cards. Tab order is document order. -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <ContentPresenter Content="Blue below" Tag="{StaticResource ZoneBlueBrush}"
                                              ContentTemplate="{StaticResource ThresholdFieldLabel}"/>
                            <TextBox Style="{StaticResource NumberBoxStyle}" HorizontalAlignment="Left" Text="{Binding BlueMax}"
                                     AutomationProperties.Name="{Binding Label, StringFormat='Blue below limit for {0} in degrees Celsius'}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <ContentPresenter Content="Green below" Tag="{StaticResource ZoneGreenBrush}"
                                              ContentTemplate="{StaticResource ThresholdFieldLabel}"/>
                            <TextBox Style="{StaticResource NumberBoxStyle}" HorizontalAlignment="Left" Text="{Binding GreenMax}"
                                     AutomationProperties.Name="{Binding Label, StringFormat='Green below limit for {0} in degrees Celsius'}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <ContentPresenter Content="Yellow up to" Tag="{StaticResource ZoneYellowBrush}"
                                              ContentTemplate="{StaticResource ThresholdFieldLabel}"/>
                            <TextBox Style="{StaticResource NumberBoxStyle}" HorizontalAlignment="Left" Text="{Binding YellowMax}"
                                     AutomationProperties.Name="{Binding Label, StringFormat='Yellow up to limit for {0} in degrees Celsius'}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Preview: four zone segments sized from the band, with the limits under the boundaries. -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding BlueWidth}"/>
                            <ColumnDefinition Width="{Binding GreenWidth}"/>
                            <ColumnDefinition Width="{Binding YellowWidth}"/>
                            <ColumnDefinition Width="{Binding RedWidth}"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Column="0" CornerRadius="4,0,0,4" Background="{StaticResource ZoneBlueBrush}"/>
                        <Border Grid.Column="1" Background="{StaticResource ZoneGreenBrush}"/>
                        <Border Grid.Column="2" Background="{StaticResource ZoneYellowBrush}"/>
                        <Border Grid.Column="3" CornerRadius="0,4,4,0" Background="{StaticResource ZoneRedBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource TickStyle}" Margin="0,5,-20,0" Text="{Binding BlueMax}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TickStyle}" Margin="0,5,-20,0" Text="{Binding GreenMax}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource TickStyle}" Margin="0,5,-20,0" Text="{Binding YellowMax}"/>
                    </Grid>

                    <!-- The error line only exists while the boxes hold an invalid trio. -->
                    <TextBlock Text="{Binding Error}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource ErrorTextBrush}"
                               Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Content="Reset" Padding="12,3"
                                MinHeight="26" FontSize="12" Command="{Binding ResetCommand}"
                                ToolTip="Use the default limits for this sensor"
                                AutomationProperties.Name="{Binding Label, StringFormat='Reset limits for {0}'}"/>
                        <Border Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding BadgeText}" Style="{StaticResource BadgeTextStyle}"/>
                        </Border>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== List view: one dense row per sensor ===== -->
        <DataTemplate x:Key="SensorRowTemplate" DataType="{x:Type vm:SensorThresholdViewModel}">
            <Border Margin="0,0,0,6" Padding="12,4" MinHeight="40" CornerRadius="8" Background="{StaticResource InputBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource ListValueWidth}"/>
                        <ColumnDefinition Width="{StaticResource ListLimitWidth}"/>
                        <ColumnDefinition Width="{StaticResource ListLimitWidth}"/>
                        <ColumnDefinition Width="{StaticResource ListLimitWidth}"/>
                        <ColumnDefinition Width="{StaticResource ListStatusWidth}"/>
                        <ColumnDefinition Width="{StaticResource ListResetWidth}"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Label}"/>
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource CaptionTextStyle}" FontSize="11" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}"/>
                        <TextBlock Text="{Binding Error}" Style="{StaticResource CaptionTextStyle}" FontSize="11" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource ErrorTextBrush}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource SensorValueStyle}"/>

                    <TextBox Grid.Column="2" Style="{StaticResource ListLimitBoxStyle}" Text="{Binding BlueMax}"
                             AutomationProperties.Name="{Binding Label, StringFormat='Blue below limit for {0} in degrees Celsius'}"/>
                    <TextBox Grid.Column="3" Style="{StaticResource ListLimitBoxStyle}" Text="{Binding GreenMax}"
                             AutomationProperties.Name="{Binding Label, StringFormat='Green below limit for {0} in degrees Celsius'}"/>
                    <TextBox Grid.Column="4" Style="{StaticResource ListLimitBoxStyle}" Text="{Binding YellowMax}"
                             AutomationProperties.Name="{Binding Label, StringFormat='Yellow up to limit for {0} in degrees Celsius'}"/>

                    <Border Grid.Column="5" Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BadgeText}" Style="{StaticResource BadgeTextStyle}"/>
                    </Border>

                    <Button Grid.Column="6" Style="{StaticResource IconButtonStyle}" Content="&#xE7A7;" Command="{Binding ResetCommand}"
                            ToolTip="Use the default limits for this sensor" ToolTipService.InitialShowDelay="300"
                            AutomationProperties.Name="{Binding Label, StringFormat='Reset limits for {0}'}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== Device sections ===== -->
        <DataTemplate x:Key="GroupHeaderTemplate" DataType="{x:Type vm:ThresholdGroupViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Device titles are spaced capitals like the Sensors page; the "Not shown" section keeps its sentence-case name. -->
                <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Text" Value="{Binding Title, Converter={StaticResource SpacedCaps}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNotShown}" Value="True">
                                    <Setter Property="Text" Value="{Binding Title}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CardGroupTemplate" DataType="{x:Type vm:ThresholdGroupViewModel}">
            <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,14"
                      Header="{Binding}" HeaderTemplate="{StaticResource GroupHeaderTemplate}">
                <StackPanel Margin="16,0,16,16">
                    <TextBlock Text="Sensors with Window, Tray and Alerts all off." Style="{StaticResource CaptionTextStyle}"
                               Margin="0,0,0,14" Visibility="{Binding IsNotShown, Converter={StaticResource BoolToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SensorCardTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="ListGroupTemplate" DataType="{x:Type vm:ThresholdGroupViewModel}">
            <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,14"
                      Header="{Binding}" HeaderTemplate="{StaticResource GroupHeaderTemplate}">
                <StackPanel Margin="8,0,8,8">
                    <TextBlock Text="Sensors with Window, Tray and Alerts all off." Style="{StaticResource CaptionTextStyle}"
                               Margin="12,0,0,10" Visibility="{Binding IsNotShown, Converter={StaticResource BoolToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SensorRowTemplate}" Focusable="False"/>
                </StackPanel>
            </Expander>
        </DataTemplate>

        <!-- ===== Defaults by sensor type: the kind cards, shared by both views ===== -->
        <DataTemplate x:Key="ThresholdCardTemplate" DataType="{x:Type vm:ThresholdRowViewModel}">
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,14,14" Padding="18,14,18,12">
                <!-- Local tab order: the three limits first, then Reset. -->
                <StackPanel KeyboardNavigation.TabNavigation="Local">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Content="Reset" TabIndex="4"
                                Padding="12,3" MinHeight="26" FontSize="12" Command="{Binding ResetCommand}"
                                ToolTip="Restore the default limits" VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Title, StringFormat='Reset {0} limits'}"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    </DockPanel>

                    <!-- The three limits (°C). -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <ContentPresenter Content="Blue below" Tag="{StaticResource ZoneBlueBrush}"
                                              ContentTemplate="{StaticResource ThresholdFieldLabel}"/>
                            <TextBox Style="{StaticResource NumberBoxStyle}" HorizontalAlignment="Left"
                                     Text="{Binding BlueMax}" TabIndex="1" AutomationProperties.Name="Blue below, degrees Celsius"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <ContentPresenter Content="Green below" Tag="{StaticResource ZoneGreenBrush}"
                                              ContentTemplate="{StaticResource ThresholdFieldLabel}"/>
                            <TextBox Style="{StaticResource NumberBoxStyle}" HorizontalAlignment="Left"
                                     Text="{Binding GreenMax}" TabIndex="2" AutomationProperties.Name="Green below, degrees Celsius"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <ContentPresenter Content="Yellow up to" Tag="{StaticResource ZoneYellowBrush}"
                                              ContentTemplate="{StaticResource ThresholdFieldLabel}"/>
                            <TextBox Style="{StaticResource NumberBoxStyle}" HorizontalAlignment="Left"
                                     Text="{Binding YellowMax}" TabIndex="3" AutomationProperties.Name="Yellow up to, degrees Celsius"/>
                        </StackPanel>
                    </Grid>

                    <!-- Preview: four zone segments sized from the band, with the limits under the boundaries. -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding BlueWidth}"/>
                            <ColumnDefinition Width="{Binding GreenWidth}"/>
                            <ColumnDefinition Width="{Binding YellowWidth}"/>
                            <ColumnDefinition Width="{Binding RedWidth}"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Column="0" CornerRadius="4,0,0,4" Background="{StaticResource ZoneBlueBrush}"/>
                        <Border Grid.Column="1" Background="{StaticResource ZoneGreenBrush}"/>
                        <Border Grid.Column="2" Background="{StaticResource ZoneYellowBrush}"/>
                        <Border Grid.Column="3" CornerRadius="0,4,4,0" Background="{StaticResource ZoneRedBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource TickStyle}" Margin="0,5,-20,0"
                                   Text="{Binding BlueMax}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TickStyle}" Margin="0,5,-20,0"
                                   Text="{Binding GreenMax}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource TickStyle}" Margin="0,5,-20,0"
                                   Text="{Binding YellowMax}"/>
                    </Grid>

                    <!-- One line, always present so the card never changes height: the error, or the red rule. -->
                    <TextBlock Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                <Setter Property="Text" Value="{Binding YellowMax, StringFormat='Red above {0} °C.'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Text" Value="{Binding Error}"/>
                                        <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,28,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,24,0">
            <TextBlock Text="Thresholds" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Set the temperatures where colours change. Each sensor has its own limits; a sensor you haven't changed follows its type's defaults."/>
        </StackPanel>

        <!-- Search and the Cards / List toggle. -->
        <Grid Grid.Row="1" Margin="0,18,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="280" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search sensors" Padding="10,0" FontSize="13"/>
                <TextBlock Text="Search sensors" Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Border Grid.Column="1" Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="ThresholdsViewMode" Content="Cards" Style="{StaticResource SegmentStyle}"
                                 IsChecked="{Binding IsListView, Converter={StaticResource InverseBool}}"
                                 AutomationProperties.Name="Cards view" ToolTip="One card per sensor"/>
                    <RadioButton GroupName="ThresholdsViewMode" Content="List" Style="{StaticResource SegmentStyle}"
                                 IsChecked="{Binding IsListView}"
                                 AutomationProperties.Name="List view" ToolTip="One compact row per sensor"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Cards view. -->
        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False" Style="{StaticResource CardsOnlyStyle}">
            <StackPanel Margin="0,0,4,8">
                <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource CardGroupTemplate}" Focusable="False"/>
                <Expander Style="{StaticResource DefaultsSectionStyle}" Header="Defaults by sensor type" IsExpanded="True"
                          HeaderTemplate="{StaticResource SectionTitleTemplate}">
                    <StackPanel Margin="16,0,16,8">
                        <TextBlock Text="New sensors start from these limits; changing one only affects sensors you haven't customised."
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding DefaultRows}" ItemTemplate="{StaticResource ThresholdCardTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Two cards per row when there is room, one when the window is narrow. -->
                                    <UniformGrid VerticalAlignment="Top"
                                                 Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource WidthToColumns}, ConverterParameter=620}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
                <Expander Style="{StaticResource DefaultsSectionStyle}" Header="Advanced: more sensors"
                          HeaderTemplate="{StaticResource SectionTitleTemplate}"
                          IsExpanded="{Binding IsAdvancedExpanded, Mode=TwoWay}">
                    <StackPanel Margin="16,0,16,8">
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12"
                                   Text="Every other temperature sensor your hardware reports, for fine-grained limits. Setting limits here does not add the sensor to the Sensors page; they apply once you add it there. Values are from the last scan."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding ScanButtonText}"
                                    Command="{Binding ScanCommand}" Padding="14,4" MinHeight="28" FontSize="13"
                                    AutomationProperties.Name="Scan for sensors"/>
                            <TextBlock Text="{Binding ScanMessage}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" Visibility="{Binding HasScanMessage, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="Every temperature sensor found is already on your Sensors page." Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding ShowAllListed, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding AdvancedGroups}" ItemTemplate="{StaticResource CardGroupTemplate}" Focusable="False"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- List view. The column titles are the first thing in the scrolled content, so they scroll away with the rows. Both
             sit inside the same content width, so the same 22 DIP inset lines them up; no scroll bar spacer is needed. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False" Style="{StaticResource ListOnlyStyle}">
            <StackPanel Margin="0,0,0,8">
                <Grid Margin="22,18,22,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource ListValueWidth}"/>
                        <ColumnDefinition Width="{StaticResource ListLimitWidth}"/>
                        <ColumnDefinition Width="{StaticResource ListLimitWidth}"/>
                        <ColumnDefinition Width="{StaticResource ListLimitWidth}"/>
                        <ColumnDefinition Width="{StaticResource ListStatusWidth}"/>
                        <ColumnDefinition Width="{StaticResource ListResetWidth}"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Sensor" Style="{StaticResource ListHeaderStyle}" TextAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="Value" Style="{StaticResource ListHeaderStyle}"/>
                    <TextBlock Grid.Column="2" Text="Blue below" Style="{StaticResource ListHeaderStyle}"/>
                    <TextBlock Grid.Column="3" Text="Green below" Style="{StaticResource ListHeaderStyle}"/>
                    <TextBlock Grid.Column="4" Text="Yellow up to" Style="{StaticResource ListHeaderStyle}"/>
                    <TextBlock Grid.Column="5" Text="Status" Style="{StaticResource ListHeaderStyle}"/>
                    <TextBlock Grid.Column="6" Text="Reset" Style="{StaticResource ListHeaderStyle}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource ListGroupTemplate}" Focusable="False"/>
                <Expander Style="{StaticResource DefaultsSectionStyle}" Header="Defaults by sensor type" IsExpanded="True"
                          HeaderTemplate="{StaticResource SectionTitleTemplate}">
                    <StackPanel Margin="16,0,16,8">
                        <TextBlock Text="New sensors start from these limits; changing one only affects sensors you haven't customised."
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding DefaultRows}" ItemTemplate="{StaticResource ThresholdCardTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid VerticalAlignment="Top"
                                                 Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource WidthToColumns}, ConverterParameter=620}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
                <Expander Style="{StaticResource DefaultsSectionStyle}" Header="Advanced: more sensors"
                          HeaderTemplate="{StaticResource SectionTitleTemplate}"
                          IsExpanded="{Binding IsAdvancedExpanded, Mode=TwoWay}">
                    <StackPanel Margin="16,0,16,8">
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12"
                                   Text="Every other temperature sensor your hardware reports, for fine-grained limits. Setting limits here does not add the sensor to the Sensors page; they apply once you add it there. Values are from the last scan."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding ScanButtonText}"
                                    Command="{Binding ScanCommand}" Padding="14,4" MinHeight="28" FontSize="13"
                                    AutomationProperties.Name="Scan for sensors"/>
                            <TextBlock Text="{Binding ScanMessage}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" Visibility="{Binding HasScanMessage, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="Every temperature sensor found is already on your Sensors page." Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding ShowAllListed, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding AdvancedGroups}" ItemTemplate="{StaticResource ListGroupTemplate}" Focusable="False"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
