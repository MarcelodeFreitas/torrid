<UserControl x:Class="Torrid.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Torrid.App.ViewModels"
             Background="Transparent" Focusable="True" IsTabStop="False" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="SettingTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="DividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource TrackBrush}"/>
            <Setter Property="Margin" Value="0,14"/>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource PanelCardStyle}">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="22,18"/>
        </Style>

        <DataTemplate x:Key="AntiCheatChoiceTemplate" DataType="{x:Type vm:AntiCheatChoice}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ProcessChipTemplate">
            <Border Margin="0,0,8,8" CornerRadius="15" Padding="12,0,3,0" Height="30" BorderThickness="1"
                    Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE711;" FontSize="10"
                            Width="24" Height="24" Margin="6,0,0,0"
                            Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" ToolTip="Remove"
                            AutomationProperties.Name="{Binding StringFormat='Remove {0}'}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,28,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,24,0">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Changes apply and save automatically."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,16,16" MaxWidth="760" HorizontalAlignment="Left">

                <!-- ===== Monitoring ===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Monitoring" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="Poll interval" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock Text="How often temperatures are read." Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Style="{StaticResource DarkSliderStyle}" Width="200" VerticalAlignment="Center"
                                        Minimum="500" Maximum="60000" TickFrequency="500" IsSnapToTickEnabled="True"
                                        SmallChange="500" LargeChange="5000"
                                        Value="{Binding PollIntervalMs}" AutomationProperties.Name="Poll interval"/>
                                <TextBlock Text="{Binding PollIntervalText}" FontSize="14" FontWeight="SemiBold" Width="56"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource DividerStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="Repeat alerts" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"
                                           Text="Repeat alerts every N minutes while a sensor stays red (0 = alert once)."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource NumberBoxStyle}" Text="{Binding RefireMinutes}"
                                         AutomationProperties.Name="Repeat alerts every, minutes"/>
                                <TextBlock Text="minutes" Style="{StaticResource FieldLabelStyle}" FontSize="13" Width="56"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Notifications ===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Notifications" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="Test alerts" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="Shows a sample Windows notification so you can check alerts reach you. The first test after installing can take up to a minute to appear."/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
                                    Content="Send test notification" Command="{Binding SendTestNotificationCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Startup ===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Startup" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="Start minimized to the tray" Style="{StaticResource SettingTitleStyle}"/>
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"
                                           Text="Torrid opens as tray icons only; click one to show this window."/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding StartMinimizedToTray}"
                                      AutomationProperties.Name="Start minimized to the tray"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Anti-cheat ===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Anti-cheat compatibility" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" FontSize="13" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Some games' anti-cheat (Riot Vanguard, Easy Anti-Cheat, BattlEye, FACEIT…) object to monitoring tools that use a hardware driver. Torrid can step aside automatically."/>

                        <!-- Live status -->
                        <Border Margin="0,14,0,0" Padding="12,8" CornerRadius="6" HorizontalAlignment="Left"
                                Background="{StaticResource InputBackgroundBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,10,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource StatusOkBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAntiCheatDetected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource ZoneYellowBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding HardwareStatusText}" FontSize="13" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAntiCheatDetected}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BannerTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="When an anti-cheat is running" Style="{StaticResource SettingTitleStyle}" Margin="0,18,0,10"/>
                        <ListBox Style="{StaticResource RadioCardListStyle}" ItemContainerStyle="{StaticResource RadioCardItemStyle}"
                                 ItemsSource="{Binding AntiCheatChoices}" ItemTemplate="{StaticResource AntiCheatChoiceTemplate}"
                                 SelectedValuePath="Value" SelectedValue="{Binding WhileAntiCheatActive}"
                                 AutomationProperties.Name="When an anti-cheat is running"/>

                        <Border Style="{StaticResource DividerStyle}" Margin="0,8,0,14"/>

                        <TextBlock Text="Also treat these programs as anti-cheat" Style="{StaticResource SettingTitleStyle}"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,12"
                                   Text="Add a game or tool by its process name; Torrid reacts to it like a known anti-cheat."/>

                        <ItemsControl ItemsSource="{Binding ExtraProcesses}" ItemTemplate="{StaticResource ProcessChipTemplate}"
                                      Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Grid MaxWidth="420" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewProcessBox" Width="260" MaxLength="100"
                                     Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Process name to add">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddProcessCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <!-- Placeholder -->
                            <TextBlock Text="Process name, e.g. MyGame.exe" FontSize="13" Margin="10,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NewProcessBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="Add" Margin="8,0,0,0"
                                    MinWidth="72" Command="{Binding AddProcessCommand}"/>
                        </Grid>

                        <TextBlock Text="{Binding KnownProductsText}" Style="{StaticResource CaptionTextStyle}" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
