<UserControl x:Class="Torrid.App.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Torrid.App.ViewModels"
             Background="Transparent" Focusable="True" IsTabStop="False" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <!-- Column widths shared by the group header labels and every row so the toggles line up. -->
        <GridLength x:Key="ValueColumnWidth">80</GridLength>
        <GridLength x:Key="ToggleColumnWidth">66</GridLength>
        <GridLength x:Key="RemoveColumnWidth">36</GridLength>

        <Style x:Key="RowValueStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding Zone, Converter={StaticResource ZoneToBrush}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasValue}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource ZoneUnknownBrush}"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <!-- A text-only muted link: brightens and underlines on hover, shows the keyboard focus ring. -->
        <Style x:Key="LimitsLinkStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SensorRowTemplate" DataType="{x:Type vm:SensorListItemViewModel}">
            <Border Style="{StaticResource PanelCardStyle}" Padding="16,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource ValueColumnWidth}"/>
                        <ColumnDefinition Width="{StaticResource ToggleColumnWidth}"/>
                        <ColumnDefinition Width="{StaticResource ToggleColumnWidth}"/>
                        <ColumnDefinition Width="{StaticResource ToggleColumnWidth}"/>
                        <ColumnDefinition Width="{StaticResource RemoveColumnWidth}"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="280"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Label}" FontSize="14" MaxLength="40"
                                     AutomationProperties.Name="{Binding DefaultLabel, StringFormat='Name for {0}'}"
                                     ToolTip="Rename this sensor. Clear the name to use the default."/>
                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE7A7;" Margin="4,0,0,0"
                                    Command="{Binding ResetLabelCommand}"
                                    ToolTip="{Binding DefaultLabel}" ToolTipService.InitialShowDelay="300"
                                    AutomationProperties.Name="{Binding DefaultLabel, StringFormat='Use the default name {0}'}"
                                    Visibility="{Binding HasCustomLabel, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                        <!-- The Limits link sits at the end of the caption line, inside the name column: the switch columns stay aligned. -->
                        <Grid Margin="1,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Caption}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}"/>
                            <Button Grid.Column="1" Style="{StaticResource LimitsLinkStyle}" Content="Limits" Margin="10,0,0,0"
                                    Command="{Binding LimitsCommand}"
                                    ToolTip="Set this sensor's colour limits on the Thresholds page"
                                    AutomationProperties.Name="{Binding DefaultLabel, StringFormat='Limits for {0}'}"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource RowValueStyle}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Center"
                              IsChecked="{Binding ShowInWindow}" AutomationProperties.Name="Show in window"
                              ToolTip="Show on the Home page"/>
                    <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Center"
                              IsChecked="{Binding ShowInTray}" AutomationProperties.Name="Show in tray"
                              ToolTip="Show as a tray icon"/>
                    <CheckBox Grid.Column="4" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Center"
                              IsChecked="{Binding Notify}" AutomationProperties.Name="Alerts"
                              ToolTip="Notify when this sensor turns red"/>

                    <!-- Only sensors added from the Add sensor panel can be removed; built-in rows leave this column empty. -->
                    <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}" Content="&#xE711;"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding RemoveCommand}"
                            Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Remove this sensor" ToolTipService.InitialShowDelay="300"
                            AutomationProperties.Name="{Binding DefaultLabel, StringFormat='Remove {0}'}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SensorGroupTemplate" DataType="{x:Type vm:SensorGroupViewModel}">
            <StackPanel Margin="0,0,0,18">
                <!-- Header: device name on the left, toggle column labels aligned over the switches (row border 1 + padding 16). -->
                <Grid Margin="2,0,17,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource ValueColumnWidth}"/>
                        <ColumnDefinition Width="{StaticResource ToggleColumnWidth}"/>
                        <ColumnDefinition Width="{StaticResource ToggleColumnWidth}"/>
                        <ColumnDefinition Width="{StaticResource ToggleColumnWidth}"/>
                        <ColumnDefinition Width="{StaticResource RemoveColumnWidth}"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom">
                        <Run Text="{Binding Title, Mode=OneWay, Converter={StaticResource SpacedCaps}}" FontSize="13"
                             FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/><Run
                             Text="   "/><Run Text="{Binding Subtitle, Mode=OneWay}" FontSize="12"
                             Foreground="{StaticResource TextMutedBrush}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="Window" Style="{StaticResource ColumnHeaderStyle}"/>
                    <TextBlock Grid.Column="3" Text="Tray" Style="{StaticResource ColumnHeaderStyle}"/>
                    <TextBlock Grid.Column="4" Text="Alerts" Style="{StaticResource ColumnHeaderStyle}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SensorRowTemplate}" Focusable="False"/>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Add sensor panel ===== -->
        <DataTemplate x:Key="AddSensorItemTemplate" DataType="{x:Type vm:AddSensorItemViewModel}">
            <Grid Margin="14,0,8,0" MinHeight="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource ValueColumnWidth}"/>
                    <ColumnDefinition Width="96"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="13" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button x:Name="AddButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Width="96" Padding="8,3" MinHeight="28"
                        FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Command="{Binding AddCommand}"
                        AutomationProperties.Name="{Binding AutomationName}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Glyph" Style="{StaticResource IconTextStyle}" Text="&#xE710;" FontSize="11"
                                   Margin="0,1,6,0" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="{Binding AddButtonText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Once added, the button reads as a quiet status ("✓ Added") rather than a disabled button. -->
                <DataTrigger Binding="{Binding IsAdded}" Value="True">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;"/>
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource ZoneGreenBrush}"/>
                    <Setter TargetName="AddButton" Property="Background" Value="Transparent"/>
                    <Setter TargetName="AddButton" Property="BorderBrush" Value="Transparent"/>
                </DataTrigger>
                <!-- A sensor a built-in card already reads: a muted "Already shown" status, never addable. -->
                <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                    <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="AddButton" Property="Background" Value="Transparent"/>
                    <Setter TargetName="AddButton" Property="BorderBrush" Value="Transparent"/>
                    <Setter TargetName="AddButton" Property="ToolTip" Value="A built-in card already shows this sensor"/>
                    <Setter TargetName="AddButton" Property="ToolTipService.ShowOnDisabled" Value="True"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AddSensorGroupTemplate" DataType="{x:Type vm:AddSensorGroupViewModel}">
            <StackPanel Margin="0,18,0,0">
                <TextBlock Text="{Binding HardwareName, Converter={StaticResource SpacedCaps}}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,7"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding HardwareName}"/>
                <Border CornerRadius="8" Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="0,2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Hairline between rows (not above the first one). -->
                                    <Border x:Name="Separator" Height="1" Margin="14,0" Background="{StaticResource TrackBrush}"/>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AddSensorItemTemplate}"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter TargetName="Separator" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,28,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Sensors" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Choose what appears in the window, in the tray and in alerts. Rename a sensor to tell identical cards apart."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddSensor.OpenCommand}"
                        ToolTip="Find more temperature sensors: motherboard and VRM, storage, memory, extra CPU sensors">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE710;" FontSize="12" Margin="0,1,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Add sensor" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding ResetToDefaultsCommand}"
                        ToolTip="Clear every name and switch back to the built-in defaults">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE72C;" FontSize="12" Margin="0,1,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Reset to defaults" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="ListScroller" Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,14,8">
                <!-- Inline Add sensor panel (not a dialog): a card above the list, only while open. -->
                <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,24" DataContext="{Binding AddSensor}"
                        Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Add a sensor" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="640" HorizontalAlignment="Left"
                                   Text="Scans your hardware for temperature sensors. Scanning briefly accesses the hardware drivers (including PawnIO for motherboard and memory sensors). It is unavailable while monitoring is paused for an anti-cheat, and in GPU-only mode it scans only GPU and storage."/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="ScanButton" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ScanCommand}" MinWidth="156"
                                    AutomationProperties.Name="{Binding ScanButtonText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE721;" FontSize="12" Margin="0,1,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="{Binding ScanButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CloseAddPanelButton" Style="{StaticResource SecondaryButtonStyle}" Content="Close" Margin="8,0,0,0" MinWidth="80"
                                    Command="{Binding CloseCommand}" ToolTip="Close the panel and discard the scan results"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" Margin="2,14,0,0" FontSize="13" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource AddSensorGroupTemplate}"
                                      Focusable="False"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource SensorGroupTemplate}"
                              Focusable="False"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
